{
  "name": "harness-code",
  "version": "0.1.0",
  "description": "A full-featured terminal coding agent",
  "type": "module",
  "bin": { "harness-code": "dist/main.js" },
  "license": "MIT",
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:fs": "vitest run tests/fs",
    "test:integration": "vitest run tests/integration tests/mcp tests/ink",
    "test:security": "vitest run tests/unit/bash-safety.test.ts tests/unit/permissions.test.ts tests/unit/security-contract.test.ts",
    "test:api": "RUN_API_TESTS=1 vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^15.0.0",
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "ink": "^7.1.0",
    "lodash-es": "^4.18.1",
    "react": "^19.2.7",
    "react-reconciler": "^0.33.0",
    "yoga-layout": "^3.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.0.0",
    "@types/lodash-es": "^4.17.12",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^4.0.0"
  }
}
